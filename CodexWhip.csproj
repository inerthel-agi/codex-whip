<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>CodexWhip.Program</StartupObject>
    <AssemblyName>CodexWhip</AssemblyName>
    <RootNamespace>CodexWhip</RootNamespace>
    <ApplicationIcon>codex-whip.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Description>A desktop whip for steering an active Codex task.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Update="codex-whip.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="whip_*.wav">
      <TargetPath>sounds\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
